    "import redis\n",
    "\n",
    "redis_client = redis.Redis(\n",
    "    host=\"localhost\",\n",
    "    port=6380,\n",
    "    decode_responses=True\n",
    ")\n",
    "\n",
    "print(\"Redis connected:\", redis_client.ping())\n",
    "print(\"Redis version:\", redis_client.info(\"server\")[\"redis_version\"])"
   ]
